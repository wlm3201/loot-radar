	"authors": ["wlm3201"],
	"contact": {
		"sources": "https://github.com/local/loot-radar"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": ["com.lootradar.dump.LootRadarDump"]
	},
	"depends": {
